  "item": [
    {
      "name": "01 Add user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/users/add",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "users",
            "add"
          ]
        },
        "description": "Run requests in numbered order. Add user saves user_id automatically.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"phone\": \"067765434567\",\n  \"address\": \"John Doe Street, Innsbruck\",\n  \"country\": \"Austria\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
              "pm.test(\"JSON response\", function () { pm.response.to.be.json; });",
              "const body = pm.response.json();",
              "pm.test(\"Generated user ID\", function () { pm.expect(body.user_id).to.be.a(\"number\").above(0); });",
              "if (pm.response.code === 201) { pm.environment.set(\"user_id\", body.user_id); }",
              "const expected = {\"name\": \"John Doe\", \"email\": \"john.doe@example.com\", \"phone\": \"067765434567\", \"address\": \"John Doe Street, Innsbruck\", \"country\": \"Austria\"};",
              "pm.test(\"Saved user fields\", function () { pm.expect(body).to.include(expected); });"
            ]
          }
        }
      ],
      "response": [
